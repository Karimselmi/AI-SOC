alert tcp any any -> $HOME_NET ![22,80,8080] (msg:"LAB Possible port scan (SYN to non-service port)"; flags:S; threshold:type threshold, track by_src, count 3, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)
alert http any any -> $HOME_NET 8080 (msg:"LAB Suspicious web payload SQLi/XSS to DVWA"; flow:to_server,established; http.uri; pcre:"/(union(\s|\+|%20)+select|%27|'|<script|%3Cscript)/i"; classtype:web-application-attack; sid:1000002; rev:1;)
